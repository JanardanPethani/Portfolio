# Google Analytics Data API (server-side only)
#
# IMPORTANT: these must NOT be prefixed with NEXT_PUBLIC_. Next.js inlines every
# NEXT_PUBLIC_* variable into the JavaScript bundle sent to the browser, so a
# NEXT_PUBLIC_ prefixed private key is published to every visitor of the site.
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Safe to expose to the browser.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
